# mailscan summary bot (system unit, oneshot — triggered by the .timer).
#
# The on-demand half of the Telegram integration. Scanning and uploading never
# call an LLM; this unit does. It polls Telegram (getUpdates) for taps on the
# "Summarize" button attached to upload notifications, and for each tap pulls the
# PDF back from Drive (rclone), summarizes it via Claude (in the configured
# summary_language), and posts
# the summary as a reply. Kept separate from the scanner daemon on purpose: an
# Anthropic/Drive/network hang must never stall scanning.
#
# Install:
#   sudo cp systemd/mailscan-bot.service systemd/mailscan-bot.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mailscan-bot.timer
#   journalctl -u mailscan-bot -f       # watch summary requests
#
# Secrets live in the repo-root .env (gitignored, NOT checked in): the same
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID as the uploader, plus ANTHROPIC_API_KEY
# (see .env.example). The env vars override config.toml, so no key ever touches
# the checked-in config. Leave ANTHROPIC_API_KEY blank to disable summaries —
# the uploader then omits the button.

[Unit]
Description=mailscan summary bot — reply to "Summarize" taps with a Claude summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alessandro.romano
WorkingDirectory=/home/alessandro.romano/mailscan
Environment=RCLONE_CONFIG=/home/alessandro.romano/.config/rclone/rclone.conf
EnvironmentFile=-/home/alessandro.romano/mailscan/.env
ExecStart=/home/alessandro.romano/mailscan/.venv/bin/mailscan bot
