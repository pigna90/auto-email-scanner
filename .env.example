# mailscan Telegram credentials — EXAMPLE. Copy to a real file, fill in, keep it
# out of git.
#
#   mkdir -p ~/.config/mailscan
#   cp .env.example ~/.config/mailscan/telegram.env
#   chmod 600 ~/.config/mailscan/telegram.env
#   $EDITOR ~/.config/mailscan/telegram.env      # put your real values in
#
# The mailscan-upload.service unit loads it via EnvironmentFile=. These env vars
# override telegram_*/anthropic_api_key in config.toml, so no secret lives in the
# checked-in config. Leave blank/unset to disable that feature (scanning +
# uploads still run regardless).
#
# Where to get them:
#   TELEGRAM_BOT_TOKEN — from @BotFather when you create the bot.
#   TELEGRAM_CHAT_ID   — message your bot, then open
#                        https://api.telegram.org/bot<token>/getUpdates and read
#                        result[].message.chat.id.
#   ANTHROPIC_API_KEY  — from https://console.anthropic.com/settings/keys.
#                        Enables LLM naming/foldering + the inline summary in the
#                        Telegram message. Blank/unset = timestamp names, default
#                        folder, no summary; uploads/notifications still run.

TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample
TELEGRAM_CHAT_ID=987654321
ANTHROPIC_API_KEY=sk-ant-...
